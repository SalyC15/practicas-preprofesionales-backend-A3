DATABASE_URL="postgresql://practicas:practicas@localhost:5432/practicas?schema=public"

# Secreto criptográfico obligatorio para firmar los tokens JWT (HS256).
# La aplicación se niega a arrancar si esta variable no está definida o está vacía.
# Generar un secreto seguro de al menos 32 bytes (ej: openssl rand -base64 32).
JWT_SECRET="cambiame-en-produccion"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Puerto en el que docker-compose publica Postgres. Si 5432 ya está ocupado en
# tu máquina, cámbialo aquí y en DATABASE_URL.
POSTGRES_PORT=5432
